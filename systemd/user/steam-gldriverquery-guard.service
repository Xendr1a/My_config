[Unit]
Description=Kill Steam gldriverquery spinners (Xwayland GLX BadValue hang)
Documentation=file:%h/.local/bin/steam-gldriverquery-guard
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/steam-gldriverquery-guard guard
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target